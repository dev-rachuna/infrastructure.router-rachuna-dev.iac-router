{
  "terraform": {
    "required_version": "1.10.5",
    "required_providers": {
      "vault": {
        "source": "hashicorp/vault",
        "version": "5.9"
      },
      "routeros": {
        "source": "terraform-routeros/routeros",
        "version": "1.99.1"
      }
    },
    "backend": {
      "http": {}
    }
  },
  "provider": {
    "vault": {
      "skip_tls_verify": true
    },
    "routeros": {
      "suppress_syso_del_warn": true,
      "hosturl": "${data.vault_kv_secret_v2.routeros_auth.data.hosturl}",
      "username": "${data.vault_kv_secret_v2.routeros_auth.data.username}",
      "password": "${data.vault_kv_secret_v2.routeros_auth.data.password}",
      "insecure": true
    }
  },
  "data": {
    "vault_kv_secret_v2": {
      "routeros_auth": {
        "mount": "dev.rachuna",
        "name": "auth/router.rachuna.dev"
      }
    }
  }
}
