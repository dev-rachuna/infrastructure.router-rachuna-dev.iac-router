{
  "module": {
    "bridge_users": {
      "source": "git::https://gitlab.com/dev.rachuna/artifacts/opentofu/routeros-interfaces.git?ref=1.0.0",
      "bridges" : {
        "bridge_users": {
          "name": "BRIDGE-USERS",
          "comment": "Users network bridge",
          "interface": "BRIDGE-USERS",
          "dhcp_snooping": true,
          "igmp_snooping": true,
          "vlan-filtering": true,
          "protocol_mode": "rstp",
          "ip_addresses": {
            "bridge_users": {
              "address": "10.1.0.1/24",
              "comment": "Users network gateway"
            }
          },
          "bridge_ports": {
            "nbo-001-mr_rachuna_dev": {
              "interface": "LAN-07",
              "comment": "nbo-001-mr.rachuna.dev",
              "trusted": true,
              "pvid": 30,
              "frame_types": "admit-only-untagged-and-priority-tagged",
              "multicast_router": "disabled"
            },
            "nbo-002-mr_rachuna_dev": {
              "interface": "LAN-06",
              "comment": "nbo-002-mr.rachuna.dev",
              "trusted": true,
              "pvid": 30,
              "frame_types": "admit-only-untagged-and-priority-tagged",
              "multicast_router": "disabled"
            },
            "lan-04-30": {
              "interface": "LAN-04-30",
              "comment": "lan-04-30 Users VLAN"
            },
            "lan-05-30": {
              "interface": "LAN-05-30",
              "comment": "lan-05-30 Users VLAN"
            }
          },
          "bridge_vlans": {
            "bridge_users": {
              "vlan_ids": ["30"],
              "comment": "Users VLAN",
              "untagged": ["LAN-07", "LAN-06"],
              "tagged": ["BRIDGE-USERS", "LAN-04", "LAN-05"]
            }
          },
          "dhcp_server": {
            "users_dhcp_server": {
              "name": "DHCP-USERS",
              "comment": "DHCP server for users network",
              "lease_time": "12h",
              "address_pool": "USERS-DHCP-POOLS",
              "delay_threshold": "0s",
              "dynamic_lease_identifiers": "client-mac",
              "dhcp_pools": {
                "users_dhcp_pool": {
                  "name": "USERS-DHCP-POOLS",
                  "ranges": ["10.1.0.2-10.1.0.254"],
                  "comment": "DHCP pool for users network"
                }
              },
              "dhcp_networks": {
                "users_dhcp_network": {
                  "address": "10.1.0.0/24",
                  "gateway": "10.1.0.1",
                  "netmask": 24,
                  "dns_server": ["10.1.0.1"],
                  "ntp_server": ["10.1.0.1"],
                  "domain": "rachuna.dev",
                  "comment": "DHCP network for users network"
                }
              },
              "dhcp_leases": {}
            }
          }
        }
      }
    }
  }
}
